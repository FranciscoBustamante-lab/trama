rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name','email','address','notes','consent','items','total','userId','attachmentPath','attachmentUrl','createdAt','status'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 150
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 8 && request.resource.data.address.size() <= 250
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
        && request.resource.data.consent == true
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 24
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'recibido'
        && (request.resource.data.attachmentPath == null || request.resource.data.attachmentPath.matches('attachments/' + request.auth.uid + '/[^/]+'))
        && (request.resource.data.attachmentUrl == null || request.resource.data.attachmentUrl is string);
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
