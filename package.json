{
  "name": "trama-tienda-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/cart.test.js",
    "emulators": "firebase emulators:start --project demo-trama-local --only auth,firestore,storage",
    "test:firebase": "firebase emulators:exec --project demo-trama-local --only auth,firestore,storage \"node scripts/test-firebase.mjs\"",
    "mobile:prepare": "npm run build && node scripts/prepare-mobile.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "firebase": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "simple-react-validator": "1.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-tools": "^15.37.0",
    "vite": "^6.4.4"
  }
}
